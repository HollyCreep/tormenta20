{
  "name": "app-tormenta20",
  "private": true,
  "version": "0.4.0",
  "description": "Criador de Personagens e Ficha Interativa para Tormenta 20 - Edição Jogo do Ano (v1.3)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --emptyOutDir false",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "index:pdf": "python scripts/index_manual_pdf.py",
    "export:data": "npx tsx scripts/export_all_data.ts",
    "mcp:server": "python mcp-server/t20_oracle_server.py",
    "mobile:sync": "npm run build && npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:copy": "npm run build && npx cap copy android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
